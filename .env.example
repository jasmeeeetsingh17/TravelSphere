# Copy to .env.local and fill in. Never commit the real file.

# Syncfusion (free community license)
VITE_SYNCFUSION_LICENSE_KEY=

# Appwrite (browser-safe ids)
VITE_APPWRITE_API_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_USERS_COLLECTION_ID=
VITE_APPWRITE_TRIPS_COLLECTION_ID=
# Optional: defaults to "bookings" and "subscribers" (created by "Set up bookings")
# VITE_APPWRITE_BOOKINGS_COLLECTION_ID=bookings
# VITE_APPWRITE_SUBSCRIBERS_COLLECTION_ID=subscribers

# Server-only secrets (read by /api routes, never sent to the browser)
# API key scopes needed: databases.read, documents.read, documents.write, users.write
APPWRITE_API_KEY=
# Optional: real AI itineraries. Without it, trips are built from a template.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
